# Local Development vs Production settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Production Security: On Render, generate a secure random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-fallback-secret-key-change-in-production

# Database Path: local SQLite default is instance/agriqueue.db. For Render with a Disk, use /var/data/agriqueue.db
DATABASE_PATH=instance/agriqueue.db

# Demo Mode: Set to "true" to seed initial demonstration farmers, mandis and historical records on a new database.
DEMO_MODE=true
